# GHCR image
LOGTO_IMAGE=ghcr.io/sdvico/logto
IMAGE_TAG=develop

# Public URLs. Point DNS and HTTPS reverse proxy to these URLs.
ENDPOINT=https://auth.example.com
ADMIN_ENDPOINT=https://admin-auth.example.com

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=logto

# Ports exposed on the server. Put TLS/reverse proxy in front in production.
CORE_PORT=3001
ADMIN_PORT=3002

# Use `next` for the IAM develop image. Use `latest` for a stable release image.
ALTERATION_TARGET=next

# Optional runtime settings
TRUST_PROXY_HEADER=1
# SSRF_ALLOWED_ADDRESSES=10.0.0.0/8
# PRIVATE_KEY_ROTATION_GRACE_PERIOD=0
