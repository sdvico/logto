# Mau file .env cho moi truong local sdvico. Copy thanh ".env" (khong commit, da co trong
# .gitignore) va sua DB_URL cho dung Postgres cua ban. Xem docs/SETUP.md de biet chi tiet
# tung buoc dung lai moi truong.

DB_URL=postgres://postgres:123123@localhost:5432/sdvico_logto
TRUST_PROXY_HEADER=1

# sdvico: don gian hoa giao dien Console cho Cuc Quan ly - AN bot cac muc nang cao/khong can
# dung ngay (khong xoa tinh nang, chi an trong sidebar). Muon MO LAI 1 muc: xoa dung ten do
# khoi danh sach duoi day (phan cach bang dau phay), roi tai lai trang Console.
#   get_started        - man hinh huong dan khoi tao (khong can vi da cau hinh xong)
#   connectors         - ket noi dang nhap MXH/SMS/Email (khong dung, chi quan ly noi bo)
#   enterprise_sso      - lien ket SSO doanh nghiep ngoai (khong can cho he thong noi bo)
#   organization_template - mau vai tro/quyen cua to chuc (dang quan ly qua script SQL rieng)
#   customize_jwt       - tuy chinh noi dung token JWT nang cao
#   webhooks            - goi API ra ngoai khi co su kien (chua co nhu cau)
# Con lai (Applications, Sign-in experience, MFA, Security, API resources, Roles, Organizations,
# Users, Audit logs, Tenant settings, Dashboard) van hien day du.
HIDDEN_SIDEBAR_ITEMS=get_started,connectors,enterprise_sso,organization_template,customize_jwt,webhooks
